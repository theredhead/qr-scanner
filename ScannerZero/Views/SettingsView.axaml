<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ScannerZero.ViewModels"
             xmlns:lucide="using:Lucide.Avalonia"
             x:Class="ScannerZero.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             Background="{DynamicResource SystemRegionBrush}">
    <Grid>
        <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <StackPanel>
                    <TextBlock Text="Settings" FontSize="28" FontWeight="Bold" />
                    <TextBlock Text="{Binding EnabledStrategySummary}" Opacity="0.65" Margin="0,4,0,0" />
                </StackPanel>

                <Button Grid.Column="1"
                        Command="{Binding ShowAboutCommand}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        ToolTip.Tip="About ScannerZero">
                    <lucide:LucideIcon Kind="Info" Size="18" />
                </Button>

                <Button Grid.Column="2"
                        Command="{Binding ResetDefaultsCommand}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        ToolTip.Tip="Reset strategy order and enabled defaults">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <lucide:LucideIcon Kind="RotateCcw" Size="18" />
                        <TextBlock Text="Reset defaults" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <TextBlock Grid.Row="1"
                       Text="Barcode strategies"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,22,0,10" />

            <ScrollViewer x:Name="StrategyScrollViewer"
                          Grid.Row="2"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="StrategyItems"
                              ItemsSource="{Binding Strategies}"
                              Margin="0,0,18,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ScannerStrategyItemViewModel">
                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,10"
                                    Classes="strategy-row">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" MinHeight="64">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Border Width="72"
                                                Height="56"
                                                Background="Transparent"
                                                VerticalAlignment="Center"
                                                PointerPressed="StrategyDragHandle_PointerPressed"
                                                ToolTip.Tip="Drag to reorder">
                                            <lucide:LucideIcon Kind="GripVertical"
                                                              Size="22"
                                                              Opacity="0.65"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,8,0">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding CodeType}" Opacity="0.6" FontSize="12" />
                                        </StackPanel>
                                    </Grid>

                                    <ToggleSwitch Grid.Column="1"
                                                  IsChecked="{Binding IsEnabled}"
                                                  IsEnabled="{Binding CanToggle}"
                                                  OnContent=""
                                                  OffContent=""
                                                  MinWidth="52"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  ToolTip.Tip="Enable strategy" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Button Grid.Row="3"
                    Command="{Binding RequestResetCommand}"
                    HorizontalAlignment="Left"
                    Margin="0,16,0,0"
                    ToolTip.Tip="Delete all scan history and saved images">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <lucide:LucideIcon Kind="Trash2" Size="18" />
                    <TextBlock Text="Clear all data" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <Canvas IsHitTestVisible="False">
            <Border x:Name="DragGhost"
                    IsVisible="False"
                    Background="{DynamicResource SystemRegionBrush}"
                    BorderBrush="{StaticResource ScannerZeroAccentBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    BoxShadow="0 8 22 #55000000"
                    Padding="12,8">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <lucide:LucideIcon Kind="GripVertical"
                                      Size="22"
                                      Opacity="0.7"
                                      VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="DragGhostTitle" FontWeight="SemiBold" />
                        <TextBlock x:Name="DragGhostSubtitle" Opacity="0.65" FontSize="12" />
                    </StackPanel>
                </Grid>
            </Border>
        </Canvas>

        <Grid IsVisible="{Binding IsResetConfirmationVisible}"
              Background="#80000000">
            <Border Background="{DynamicResource SystemRegionBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    BoxShadow="0 8 32 #55000000"
                    Padding="24"
                    MaxWidth="360"
                    Margin="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <TextBlock Text="Clear all data?" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="This deletes your complete scan history and every saved scan image. This cannot be undone."
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Command="{Binding CancelResetCommand}" Content="Cancel" />
                        <Button Command="{Binding ConfirmResetCommand}" Content="Clear all data" IsDefault="True" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
