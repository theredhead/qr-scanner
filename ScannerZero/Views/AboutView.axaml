<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ScannerZero.ViewModels"
             xmlns:views="using:ScannerZero.Views"
             xmlns:lucide="using:Lucide.Avalonia"
             x:Class="ScannerZero.Views.AboutView"
             x:DataType="vm:AboutViewModel"
             Background="{DynamicResource SystemRegionBrush}">
    <Grid RowDefinitions="Auto,Auto,*" Margin="20">
        <Grid ColumnDefinitions="Auto,*">
            <Button Command="{Binding BackCommand}"
                    Width="40"
                    Height="40"
                    Padding="0"
                    ToolTip.Tip="Back to settings">
                <lucide:LucideIcon Kind="ArrowLeft" Size="20" />
            </Button>

            <TextBlock Grid.Column="1"
                       Text="About"
                       FontSize="28"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0" />
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,12,0,16">
            <Button Command="{Binding OpenRepositoryCommand}"
                    CommandParameter="{Binding $parent[TopLevel]}"
                    ToolTip.Tip="Open GitHub repository">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <lucide:LucideIcon Kind="GitBranch" Size="18" />
                    <TextBlock Text="GitHub" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Command="{Binding OpenLicenseCommand}"
                    CommandParameter="{Binding $parent[TopLevel]}"
                    ToolTip.Tip="Open MIT license">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <lucide:LucideIcon Kind="BookOpen" Size="18" />
                    <TextBlock Text="MIT License" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>

        <ScrollViewer Grid.Row="2">
            <views:MarkdownView Markdown="{Binding Readme}" />
        </ScrollViewer>
    </Grid>
</UserControl>
