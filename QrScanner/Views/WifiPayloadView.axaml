<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:QrScanner.ViewModels"
             xmlns:lucide="using:Lucide.Avalonia"
             x:Class="QrScanner.Views.WifiPayloadView"
             x:DataType="vm:WifiPayloadViewModel">
    <StackPanel Spacing="10">
        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="2">
            <lucide:LucideIcon Grid.RowSpan="2" Kind="Wifi" Size="24" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding WifiSsid}" FontWeight="SemiBold" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding WifiSecurity}" Opacity="0.65" />
            <TextBlock Grid.Column="2" Text="{Binding WifiVisibility}" Opacity="0.65" />
        </Grid>

        <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
            <Button Command="{Binding ConnectWifiCommand}"
                    IsEnabled="{Binding IsWifiConnectSupported}"
                    Background="{DynamicResource SystemAccentColor}"
                    Foreground="White"
                    ToolTip.Tip="Connect to Wi-Fi">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <lucide:LucideIcon Kind="Wifi" Size="18" />
                    <TextBlock Text="Connect" />
                </StackPanel>
            </Button>

            <Button Command="{Binding CopyTextCommand}"
                    CommandParameter="{Binding $parent[TopLevel]}"
                    ToolTip.Tip="Copy Wi-Fi details">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <lucide:LucideIcon Kind="Copy" Size="18" />
                    <TextBlock Text="Copy details" />
                </StackPanel>
            </Button>

            <Button Command="{Binding ShareCommand}"
                    IsVisible="{Binding IsShareSupported}"
                    ToolTip.Tip="Share scan image">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <lucide:LucideIcon Kind="Share2" Size="18" />
                    <TextBlock Text="Share image" />
                </StackPanel>
            </Button>

            <Button Command="{Binding DismissCommand}"
                    ToolTip.Tip="Scan another code">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <lucide:LucideIcon Kind="Scan" Size="18" />
                    <TextBlock Text="Scan again" />
                </StackPanel>
            </Button>
        </WrapPanel>

        <TextBlock Text="{Binding StatusMessage}"
                   IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Opacity="0.8"
                   FontWeight="Medium" />
    </StackPanel>
</UserControl>
