<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:QrScanner.ViewModels"
             xmlns:lucide="using:Lucide.Avalonia"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="700"
             x:Class="QrScanner.Views.ScanView"
             x:DataType="vm:ScanViewModel">
    <Grid Background="Black">
        <!-- Live Camera Viewport -->
        <ContentControl Content="{Binding PreviewControl}"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />

        <!-- Viewfinder Box & Helper Overlay -->
        <Grid Background="Transparent">
            <Border Width="260" Height="260"
                    BorderBrush="{DynamicResource SystemAccentColor}"
                    BorderThickness="3"
                    CornerRadius="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BoxShadow="0 0 32 #99000000" />

            <!-- Bottom status pill -->
            <Border Background="#CC000000"
                    CornerRadius="20"
                    Padding="16,10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="16,0,16,40">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <lucide:LucideIcon Kind="Scan" Size="18" Foreground="White" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="White"
                               FontWeight="Medium"
                               FontSize="14"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
