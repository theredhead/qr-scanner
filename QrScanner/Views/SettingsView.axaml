<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:QrScanner.ViewModels"
             xmlns:lucide="using:Lucide.Avalonia"
             x:Class="QrScanner.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             Background="{DynamicResource SystemRegionBrush}">
    <Grid>
        <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <StackPanel>
                    <TextBlock Text="Settings" FontSize="28" FontWeight="Bold" />
                    <TextBlock Text="{Binding EnabledStrategySummary}" Opacity="0.65" Margin="0,4,0,0" />
                </StackPanel>

                <Button Grid.Column="1"
                        Command="{Binding ShowAboutCommand}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        ToolTip.Tip="About ScannerZero">
                    <lucide:LucideIcon Kind="Info" Size="18" />
                </Button>

                <Button Grid.Column="2"
                        Command="{Binding ResetDefaultsCommand}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        ToolTip.Tip="Reset barcode strategies">
                    <lucide:LucideIcon Kind="RotateCcw" Size="18" />
                </Button>
            </Grid>

            <TextBlock Grid.Row="1"
                       Text="Barcode strategies"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,22,0,10" />

            <ScrollViewer Grid.Row="2">
                <ItemsControl ItemsSource="{Binding Strategies}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ScannerStrategyItemViewModel">
                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,10">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                    <ToggleSwitch IsChecked="{Binding IsEnabled}"
                                                  IsEnabled="{Binding CanToggle}"
                                                  VerticalAlignment="Center"
                                                  ToolTip.Tip="Enable strategy" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding CodeType}" Opacity="0.6" FontSize="12" />
                                    </StackPanel>

                                    <Button Grid.Column="2"
                                            Command="{Binding MoveUpCommand}"
                                            IsEnabled="{Binding CanMoveUp}"
                                            Width="36"
                                            Height="36"
                                            Padding="0"
                                            ToolTip.Tip="Move earlier">
                                        <lucide:LucideIcon Kind="ArrowUp" Size="18" />
                                    </Button>

                                    <Button Grid.Column="3"
                                            Command="{Binding MoveDownCommand}"
                                            IsEnabled="{Binding CanMoveDown}"
                                            Width="36"
                                            Height="36"
                                            Padding="0"
                                            ToolTip.Tip="Move later">
                                        <lucide:LucideIcon Kind="ArrowDown" Size="18" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Button Grid.Row="3"
                    Command="{Binding RequestResetCommand}"
                    HorizontalAlignment="Left"
                    Margin="0,16,0,0"
                    ToolTip.Tip="Delete all scan history and saved images">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <lucide:LucideIcon Kind="Trash2" Size="18" />
                    <TextBlock Text="Clear all data" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid IsVisible="{Binding IsResetConfirmationVisible}"
              Background="#80000000">
            <Border Background="{DynamicResource SystemRegionBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    BoxShadow="0 8 32 #55000000"
                    Padding="24"
                    MaxWidth="360"
                    Margin="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <TextBlock Text="Clear all data?" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="This deletes your complete scan history and every saved scan image. This cannot be undone."
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Command="{Binding CancelResetCommand}" Content="Cancel" />
                        <Button Command="{Binding ConfirmResetCommand}" Content="Clear all data" IsDefault="True" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
