<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:QrScanner.ViewModels"
             xmlns:models="using:QrScanner.Models"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="700"
             x:Class="QrScanner.Views.HistoryView"
             x:DataType="vm:HistoryViewModel">
    <Grid RowDefinitions="Auto,*,Auto" Margin="12">
        <TextBox Grid.Row="0"
                 PlaceholderText="Search history..."
                 Text="{Binding SearchText}"
                 Margin="0,0,0,8" />

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Records}"
                 SelectedItem="{Binding SelectedRecord}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:ScanRecord">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4">
                        <Image Width="40" Height="40" Source="{Binding ImagePath}" Stretch="UniformToFill" />
                        <StackPanel>
                            <TextBlock Text="{Binding RawText}" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                            <TextBlock Text="{Binding ScannedAtUtc}" Opacity="0.6" FontSize="11" />
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="2"
                IsVisible="{Binding SelectedRecord, Converter={x:Static ObjectConverters.IsNotNull}}"
                Padding="8" Margin="0,8,0,0" BorderThickness="1" BorderBrush="{DynamicResource SystemBaseLowColor}">
            <StackPanel Spacing="8">
                <Image Source="{Binding SelectedImage}" MaxHeight="160" Stretch="Uniform" />
                <TextBox Text="{Binding SelectedRecord.RawText}"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MaxHeight="100" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Copy"
                            Command="{Binding CopyTextCommand}"
                            CommandParameter="{Binding $parent[TopLevel]}" />
                    <Button Content="Open link"
                            Command="{Binding OpenLinkCommand}"
                            CommandParameter="{Binding $parent[TopLevel]}" />
                    <Button Content="Connect to Wi-Fi"
                            IsVisible="{Binding IsWifiSelected}"
                            IsEnabled="{Binding IsWifiConnectSupported}"
                            Command="{Binding ConnectWifiCommand}"
                            ToolTip.Tip="Not supported on this platform" />
                    <Button Content="Delete" Command="{Binding DeleteCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
