<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:QrScanner.ViewModels"
             xmlns:models="using:QrScanner.Models"
             xmlns:views="using:QrScanner.Views"
             xmlns:lucide="using:Lucide.Avalonia"
             x:Class="QrScanner.Views.HistoryView"
             x:DataType="vm:HistoryViewModel">
    <UserControl.Resources>
        <views:HistoryImageConverter x:Key="HistoryImageConverter" />
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*" Margin="0,12,0,0">
        <Grid Margin="16,0,16,12">
            <TextBox PlaceholderText="Search history..." Text="{Binding SearchText}" />
        </Grid>

        <ListBox Grid.Row="1" Background="Transparent" BorderThickness="0" ItemsSource="{Binding Records}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:ScanRecord">
                    <Grid ColumnDefinitions="56,*,Auto" Margin="16,6">
                        <!-- Tap target to open detail page -->
                        <Button Grid.Column="0" Grid.ColumnSpan="2"
                                Command="{Binding $parent[UserControl].DataContext.OpenRecordCommand}"
                                CommandParameter="{Binding}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch">
                            <Grid ColumnDefinitions="56,*">
                                <Border Width="48" Height="48" CornerRadius="8" ClipToBounds="True">
                                    <Image Source="{Binding ImagePath, Converter={StaticResource HistoryImageConverter}}" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding RawText}" TextTrimming="CharacterEllipsis" FontWeight="Medium" />
                                    <TextBlock Text="{Binding ScannedAtUtc}" Opacity="0.6" FontSize="11" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Button Grid.Column="2"
                                Command="{Binding $parent[UserControl].DataContext.RemoveCommand}"
                                CommandParameter="{Binding}"
                                ToolTip.Tip="Remove from history"
                                Padding="8"
                                Background="Transparent"
                                BorderThickness="0">
                            <lucide:LucideIcon Kind="Trash2" Size="18" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
